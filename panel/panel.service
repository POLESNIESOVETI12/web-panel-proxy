[Unit]
Description=Telegram Web Proxy Multi-user Panel
After=network-online.target tproxy-server.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/tproxy-panel/panel.env
ExecStart=/usr/local/bin/tproxy-panel
Restart=on-failure
RestartSec=2s
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/tproxy-panel
ReadWritePaths=/etc/tproxy-server

[Install]
WantedBy=multi-user.target
